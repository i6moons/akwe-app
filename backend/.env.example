# AKWÈ — Backend
# Copiez en `.env.local`. Ce fichier ne contient jamais de vraie valeur.

# --- Supabase (projet cnwrgnpsvwxpeuyijbeu) ----------------------------------
# Dashboard : https://supabase.com/dashboard/project/cnwrgnpsvwxpeuyijbeu
# Settings → API : coller anon et service_role ici, jamais dans le chat.
SUPABASE_URL=https://cnwrgnpsvwxpeuyijbeu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- IA vocale ---------------------------------------------------------------
# Modèle utilisé par POST /api/voice/parse pour structurer la phrase dictée.
LLM_API_KEY=
LLM_MODEL=

# --- Reçus WhatsApp / SMS ----------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Mobile money (sandbox) --------------------------------------------------
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=

# --- Serveur autonome (src/server.ts) ---------------------------------------
# Tous optionnels : les valeurs par défaut suffisent en développement.
PORT=3460
HOST=127.0.0.1
# Origine autorisée en CORS. Vide = `*`, à restreindre en déploiement.
CORS_ORIGIN=
# Point d'entrée compatible OpenAI pour POST /api/voice/parse.
# Défaut : https://api.groq.com/openai/v1/chat/completions
LLM_API_URL=

# AKWÈ — Frontend
# Copiez ce fichier en `.env.local`. Seules les variables `NEXT_PUBLIC_` sont
# visibles dans le navigateur : n'y mettez jamais de secret.

# Base des appels API. Vide = même origine (routes Next dans `frontend/app/api`).
# Renseignez une URL si le backend est déployé séparément.
NEXT_PUBLIC_API_URL=

# Supabase — clés publiques uniquement (voir backend/.env.example pour le reste).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# `true` = aucun appel réseau, données de démonstration locales.
# C'est le filet de sécurité du pitch : la démo tourne même sans backend.
NEXT_PUBLIC_DEMO_MODE=true
